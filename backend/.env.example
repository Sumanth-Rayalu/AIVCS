# Copy this file to ".env" and fill in your real connection string.
# Get it from Atlas: Cluster0 -> Connect -> Drivers -> Python.
# It looks like: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
DB_NAME=aivcs
MONGODB_USERS_COLLECTION=userdata
AIVCS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
