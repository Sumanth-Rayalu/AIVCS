# ==============================================================================
# AIVCS Configuration Template
# Copy this file to ".env" and fill in your real credentials.
# Never commit real credentials or API keys to the repository.
# ==============================================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
DB_NAME=aivcs
MONGODB_USERS_COLLECTION=userdata

# Backend CORS Allowed Origins (comma-separated)
AIVCS_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
